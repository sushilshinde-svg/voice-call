# URL of the signaling backend (Node.js server)
VITE_SERVER_URL=https://your-render-backend-url.onrender.com

# --- TURN server (optional but recommended for production) ---
# A TURN server relays audio when both callers are behind firewalls /
# symmetric NAT / mobile data. Without it, calls connect on the same
# network but have NO audio across different networks.
#
# If these are left unset, the app falls back to a free public TURN server
# (rate-limited, fine for testing). For reliable production use, create a
# free account at https://www.metered.ca/tools/openrelay/ or use Twilio
# Network Traversal, then fill these in.
#
# VITE_TURN_URLS accepts one or more comma-separated TURN URLs.
VITE_TURN_URLS=turn:your-turn-host:80,turn:your-turn-host:443?transport=tcp
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-credential
